<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/add_expense_widget"
    android:padding="16dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/cd_home_widget_add_expense"
    android:background="@drawable/add_expense_widget_background">

    <include
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        layout="@layout/add_expense_widget_summary" />

    <ImageView
        android:id="@+id/widget_action"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/add_expense_widget_plus"
        android:background="@drawable/add_expense_widget_compact_action_background"
        android:importantForAccessibility="no" />

</LinearLayout>
