meta {
  name: Upload de áudio local
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/collections/audio/process
  body: file
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: audio/mp4
}

body:file {
  file: @file({{audioFile}}) @contentType(audio/mp4)
}

script:pre-request {
  if (!bru.getVar("token")) {
    throw new Error("Envie Login local antes do upload.");
  }
}

tests {
  test("Áudio recebido", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody()).to.deep.equal({ status: "accepted" });
  });
}

docs {
  Faça login e selecione uma gravação M4A na aba Body ou configure audioFile no ambiente.
  Binário direto, Content-Type audio/mp4, não vazio, até 2 MiB. Não é multipart.
  CLI opcional: make bruno-upload com variáveis CORDATO_DEVELOPMENT_* no processo.
  A rota aceita os bytes, sem processamento, persistência ou criação de despesa.
}
