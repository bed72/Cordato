# Exemplo somente. Não reutilize o .env do antigo projeto Node.
# Configure os valores reais no ambiente privado do serviço Compose no Dokploy.
POCKETBASE_PUBLIC_URL=https://pocketbase.cordato.cloud

# Bootstrap de instalação NOVA. Podem ser retirados após a migration concluir.
SMTP_PASSWORD=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Obrigatória em TODOS os reinícios: exatamente 32 caracteres ASCII aleatórios.
# Guardar separadamente dos backups. Não é descartável após o bootstrap.
POCKETBASE_ENCRYPTION_KEY=
